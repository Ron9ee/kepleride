		"scrollbarSlider.background": "#00ff4133",
		"scrollbarSlider.hoverBackground": "#00ff4144",
		"scrollbarSlider.activeBackground": "#00ff4166"
	},
	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#00aa2a",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["string", "string.quoted"],
			"settings": {
				"foreground": "#66ff88"
			}
		},
		{
			"scope": ["keyword", "storage.type", "storage.modifier"],
			"settings": {
				"foreground": "#00ff41",
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["entity.name.function", "support.function"],
			"settings": {
				"foreground": "#00ffaa"
			}
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "support.class"],
			"settings": {
				"foreground": "#00ff88"
			}
		},
		{
			"scope": ["variable", "variable.other"],
			"settings": {
				"foreground": "#00ff41"
			}
		},
		{
			"scope": ["constant.numeric", "constant.language"],
			"settings": {
				"foreground": "#66ffaa"
			}
		},
		{
			"scope": ["constant.character.escape"],
			"settings": {
				"foreground": "#00ffcc"
			}
		},
		{
			"scope": ["entity.name.tag"],
			"settings": {
				"foreground": "#00ff41",
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": {
				"foreground": "#00ffaa"
			}
		},
		{
			"scope": ["support.type.property-name"],
			"settings": {
				"foreground": "#00ff88"
			}
		},
		{
			"scope": ["punctuation"],
			"settings": {
				"foreground": "#00cc33"
			}
		},
		{
			"scope": ["invalid"],
			"settings": {
				"foreground": "#ff4141",
				"fontStyle": "bold"
			}
		}
	]
}
